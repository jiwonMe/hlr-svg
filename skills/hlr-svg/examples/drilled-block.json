{
  "title": "A block with a hole drilled through it",
  "width": 640,
  "height": 480,
  "camera": {
    "projection": "perspective",
    "azimuth": 40,
    "elevation": 28,
    "fov": 30
  },
  "style": {
    "strokeWidthVisible": 2,
    "strokeWidthHidden": 1,
    "dashArrayHidden": "5 4"
