      "op": "subtract",
      "a": { "type": "box", "center": [0, 0, 0], "size": [3, 1.2, 2] },
      "b": {
        "type": "cylinder",
        "base": [0, -1, 0],
        "axis": [0, 1, 0],
        "height": 2,
        "radius": 0.55
      }
    }
  ]
}
